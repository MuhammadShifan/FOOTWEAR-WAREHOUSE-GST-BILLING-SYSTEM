# ==============================================================================
# AS MARKETING - Footwear Warehouse Inventory & GST Billing System
# Frontend Client Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'client/' directory:
#    cp client/.env.example client/.env
# 2. Configure variables as needed for your target environment.
#
# IMPORTANT SECURITY REMINDER:
# Variables prefixed with 'VITE_' are embedded directly into client bundles!
# NEVER put private API secrets, database credentials, or passwords here.
# ==============================================================================

# Backend API Base URL
# Local Development: http://localhost:5001/api
# Production Deployment: https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api
