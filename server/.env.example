# ==============================================================================
# AS MARKETING - Footwear Warehouse Inventory & GST Billing System
# Backend Server Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'server/' directory:
#    cp server/.env.example server/.env
# 2. Replace all placeholder values with your real configuration.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<db_user>:<db_password>@<cluster_host>/<database_name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bill_creator?retryWrites=true&w=majority

# JWT Authentication Configuration
# Generate a cryptographically secure 256-bit key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Initial Administrator Credentials (BACKEND ONLY - NEVER expose to client applications)
ADMIN_EMAIL=admin@asmarketing.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: Nodemailer Email Service Configuration (for OTP and alert dispatch)
EMAIL_SERVICE=gmail
EMAIL_USER=your_warehouse_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM="AS MARKETING Security" <your_warehouse_email@gmail.com>

# Optional: Public Business Details (Default values for printed GST Invoices)
BUSINESS_EMAIL=asmarketingtnj@gmail.com
BUSINESS_GSTIN=33APDPM1586P1ZG
